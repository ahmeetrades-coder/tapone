# Standalone server (server/src/server.ts — `bun run start`).
# PORT is injected by the host (FadeHost sets it); DATABASE_PATH must
# point at the host's PERSISTENT disk or the database is lost on redeploy
# (FadeHost: /data/app.db). CLIENT_DIR defaults to ./client/dist.
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=/data/app.db
CLIENT_DIR=
SETTLE_TIME=00:15
SETTLE_TZ=America/Los_Angeles

# TapOne configuration reference.
#
# TapOne stores its live configuration in the `settings` table of app.db,
# edited from the owner panel (Admin -> Settings). Hosts that inject
# configuration through environment variables use these names — they map
# 1:1 to the settings keys. Nothing here is a real secret value; fill in
# your own on the host / in the admin panel, never commit real values.

# Google OAuth Client ID — required for Google sign-in. The live site
# origin must also be registered in Google Cloud Console (Authorized
# JavaScript origins + Authorized redirect URIs) and the OAuth app
# published, or only test users can sign in.
GOOGLE_CLIENT_ID=

# Owner panel login. Change the password before going live.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Shared secret offerwall partners send with each postback. Set this
# before connecting a live offerwall — while empty, postbacks are
# accepted without a secret.
POSTBACK_SECRET=

# Money settings (cents are integer cents; 100 = $1).
DAILY_POOL_CENTS=10000
AFFILIATE_POOL_CENTS=150000
MIN_WITHDRAW_CENTS=500
USER_SHARE_PCT=70
AFFILIATE_EARNING_PCT=8
AFFILIATE_SPENDING_PCT=5
CHECKIN_BONUS_CENTS=5
LEVEL_REWARD_CENTS=50

# Social links shown in the footer and on the Contact page. Blank = hidden.
SOCIAL_DISCORD=
SOCIAL_TWITTER=
SOCIAL_TELEGRAM=
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
SOCIAL_TIKTOK=
SOCIAL_INSTAGRAM=
